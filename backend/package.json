{
  "name": "petadopt-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "kill-port": "lsof -ti :4000 | xargs kill -9 2>/dev/null || true",
    "build": "node_modules/.bin/esbuild index.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.bundle.cjs --external:kerberos --external:@mongodb-js/zstd --external:@aws-sdk/credential-providers --external:mongodb-client-encryption --external:snappy --external:socks --external:aws4",
    "start": "node index.js",
    "predev": "npm run kill-port",
    "dev": "node index.js",
    "dev:watch": "nodemon --config nodemon.json index.js",
    "dev:bundle": "npm run build && nodemon --watch . --ext js,json --ignore dist/ --ignore node_modules/ --exec \"npm run build && node dist/server.bundle.cjs\""
  },
  "dependencies": {
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "nodemon": "^3.0.2"
  }
}
